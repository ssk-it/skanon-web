{
  "name": "@ssk-it/skanon",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./startup": "./src/startup.ts",
    "./App.vue": "./src/App.vue",
    "./router": "./src/router.ts",
    "./extension": "./src/extension/extension.ts",
    "./extension/composer": "./src/extension/composer.ts",
    "./platform/ports": "./src/platform/ports.ts",
    "./platform/platform-token": "./src/platform/platform-token.ts",
    "./platform/web": "./src/platform/web.ts",
    "./platform/web-vault": "./src/platform/web-vault.ts",
    "./injection": "./src/core/injection.ts",
