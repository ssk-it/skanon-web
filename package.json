    "./ui/*.vue": "./src/ui/*.vue",
    "./ui/*": "./src/ui/*.ts",
    "./test/http": "./src/core/http/http-testing.ts",
    "./test/pages": "./src/test-pages.ts"
  },
  "scripts": {
    "dev:web": "vite --mode web",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --project jsdom --project tools",
    "test:watch": "vitest --project jsdom --project tools",
    "test:coverage": "vitest run --project jsdom --coverage",
    "build:web": "vue-tsc --noEmit && vite build --mode web",
    "test:browser": "vitest run --project browser"
